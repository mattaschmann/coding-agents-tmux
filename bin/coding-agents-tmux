#!/usr/bin/env bash

set -euo pipefail

CURRENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLI="$CURRENT_DIR/src/cli.ts"

if [ ! -f "$CLI" ]; then
  printf 'coding-agents-tmux: missing CLI at %s\n' "$CLI" >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  printf 'coding-agents-tmux: node is required but was not found in PATH\n' >&2
  exit 1
fi

# Fast path for tmux status redraws: `status-cached <variant>` reads a cached
# render via a dependency-light entry (~30ms) instead of loading the full CLI
# graph (~130ms, over tmux's 100ms #() budget). Exits non-zero on a cache miss
# so the caller can fall back to a full `status` render. Optional third arg:
# max cache age in milliseconds.
if [ "${1:-}" = "status-cached" ]; then
  CACHE_CLI="$CURRENT_DIR/src/status-cache.ts"
  if [ -f "$CACHE_CLI" ]; then
    exec node --disable-warning=ExperimentalWarning "$CACHE_CLI" "${2:-}" "${3:-}"
  fi
  exit 1
fi

exec node --disable-warning=ExperimentalWarning "$CLI" "$@"
